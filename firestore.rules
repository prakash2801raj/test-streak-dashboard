rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each anonymous install gets its own uid from Firebase Auth.
    // These rules make sure that uid can only ever read/write its own data,
    // even though there's no visible login screen in the app.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
